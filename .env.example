# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development: run `npm run db:start` and use the URL below as-is.
# Production: point this at a managed Postgres (Neon, Supabase, RDS).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"

# Chatbot. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Confirmation emails. Free tier at https://resend.com/api-keys
RESEND_API_KEY=

# Must be a domain you verified in Resend. The default below works without a
# domain, but can ONLY deliver to the address that owns the Resend account.
FROM_EMAIL="Illudesk <onboarding@resend.dev>"

# Admin accounts now live in the database (npm run db:seed creates the first).
# Optional: pre-set the seeded admin's credentials instead of a random password.
SEED_ADMIN_EMAIL=admin@illudesk.example
SEED_ADMIN_PASSWORD=

# Signs the admin session cookie. 32+ random chars. Rotate = everyone signed out.
AUTH_SECRET=

# Set to false if this server is exposed directly to the internet
# (no nginx/Cloudflare/Vercel in front), so x-forwarded-for is not trusted.
TRUSTED_PROXY=true
