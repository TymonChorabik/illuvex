// Illudesk data model.
//
// TENANCY: every business-owned row carries `tenantId`. Today the app runs a
// single tenant (Illudesk itself), but scoping queries by tenant from day one
// is what makes reselling a switch to flip rather than a rebuild. Never write
// a query against these tables without a tenant filter.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A business using the system. One row today; many if the system is resold.
model Tenant {
  id        String   @id @default(cuid())
  /// URL-safe key, e.g. "illudesk". Used for subdomain or path routing later.
  slug      String   @unique
  name      String
  /// Branding + contact overrides. Mirrors src/lib/site.ts.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  clients  Client[]
  packages Package[]
  quotes   Quote[]
  orders   Order[]
  tickets  Ticket[]
  invoices Invoice[]

  @@map("tenants")
}

enum UserRole {
  /// Illudesk staff: sees everything for their tenant.
  ADMIN
  /// Illudesk staff with limited rights.
  STAFF
  /// A customer of the tenant: sees only their own client record.
  CUSTOMER
}

/// Anyone who can sign in — staff and customers share one table so that
/// sessions, password reset and lockout logic exist in exactly one place.
model User {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String
  /// scrypt hash. Never store or log anything reversible.
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)

  /// Set when the address is confirmed; null means unverified.
  emailVerifiedAt DateTime?
  /// Consecutive failed sign-ins, reset on success. Drives lockout.
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  disabledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  tokens   VerificationToken[]
  /// Set only for CUSTOMER accounts.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ticketMessages TicketMessage[]

  /// Email is unique per tenant, not globally — two resold businesses may
  /// legitimately have the same customer.
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

/// Server-side session. Storing sessions (rather than only signing a JWT)
/// means sign-out and "revoke all devices" actually work.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie token. A leaked database gives no usable sessions.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Audit trail for "where am I signed in".
  userAgent String?
  ipHash    String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// Emailed to a client so they can open a quote without an account yet.
  QUOTE_ACCESS
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// The customer business. Separate from User because one company can have
/// several people who sign in, and because a client can exist before anyone
/// has an account (e.g. a quote raised by phone).
model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Human-readable customer number shown on quotes/invoices, e.g.
  /// "KLT-0001". Allocated once when the client is first created and never
  /// reused -- a permanent identifier, unlike a quote/invoice number which
  /// resets in scope. Nullable only so existing rows can be backfilled.
  number       String?
  name         String
  contactName  String?
  email        String
  phone        String?
  /// Company registration / VAT number, needed on invoices.
  vatNumber    String?
  addressLine1 String?
  addressLine2 String?
  postcode     String?
  city         String?
  country      String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  quotes   Quote[]
  orders   Order[]
  tickets  Ticket[]
  invoices Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, email])
  @@map("clients")
}

/// A service package. Moved out of src/lib/offers.ts so staff can edit
/// pricing without a deploy.
model Package {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  summary     String
  /// Minor units (cents) — never floats for money.
  priceCents  Int
  priceUnit   String?
  currency    String  @default("EUR")
  category    String
  timeline    String
  includes    String[]
  features    String[]
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteLines QuoteLine[]
  orders     Order[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("packages")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// An offerte. Staff build it, the client accepts or rejects it, and an
/// accepted quote becomes an order and then an invoice.
model Quote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Human reference, e.g. OFF-2026-0001. Unique per tenant.
  reference String
  status    QuoteStatus @default(DRAFT)
  title     String
  notes     String?
  currency  String      @default("EUR")

  /// Denormalised money totals in minor units, recomputed on every write.
  subtotalCents Int @default(0)
  vatCents      Int @default(0)
  totalCents    Int @default(0)

  /// SHA-256 of the link token emailed to the client. A client accepts a
  /// quote before they have an account, so this lives on the quote rather
  /// than on VerificationToken (which requires a user).
  accessTokenHash      String?   @unique
  accessTokenExpiresAt DateTime?

  validUntil DateTime?
  sentAt     DateTime?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lines    QuoteLine[]
  orders   Order[]
  invoices Invoice[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Optional link to a catalogue package; free-text lines have none.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  description   String
  quantity      Int    @default(1)
  unitPriceCents Int
  /// Basis points, so 21% BTW is 2100 — avoids float rounding on tax.
  vatRateBps    Int    @default(2100)
  sortOrder     Int    @default(0)

  @@index([quoteId])
  @@map("quote_lines")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

/// A confirmed piece of work. This is what the current JSON store becomes.
model Order {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quoteId  String?
  quote    Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  reference String
  status    OrderStatus @default(PENDING)

  /// Snapshot of what was requested, so later catalogue edits never rewrite
  /// history.
  packageName String
  priceCents  Int
  priceUnit   String?
  currency    String  @default("EUR")

  /// Contact details as submitted, before a Client record may exist.
  contactName  String
  contactEmail String
  company      String?
  phone        String?
  notes        String?

  confirmationEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets  Ticket[]
  invoices Invoice[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, contactEmail])
  @@map("orders")
}

enum TicketStatus {
  OPEN
  WAITING_ON_CUSTOMER
  WAITING_ON_US
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Support ticket raised from the customer portal.
model Ticket {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  reference String
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages TicketMessage[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String
  /// Staff-only note the customer never sees.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quoteId  String?
  quote    Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Sequential per tenant and never reused — tax authorities require gapless
  /// numbering, so this is allocated in a transaction at ISSUE time. A draft
  /// has no number, which is what keeps the sequence gapless when a draft is
  /// deleted. Postgres allows many NULLs under a unique index.
  number String?
  status InvoiceStatus @default(DRAFT)

  currency      String @default("EUR")
  subtotalCents Int    @default(0)
  vatCents      Int    @default(0)
  totalCents    Int    @default(0)
  paidCents     Int    @default(0)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  /// Last time the PDF was actually emailed to the client. Unlike a quote,
  /// re-sending is allowed and expected ("I lost it, can you resend") — this
  /// is informational, not a one-shot gate.
  emailSentAt DateTime?

  /// Frozen copy of the client's billing details at issue time. An invoice
  /// must not change because the client later moved office.
  billingSnapshot Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  vatRateBps     Int    @default(2100)
  sortOrder      Int    @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// Append-only audit log. Who changed what, for disputes and for the
/// "not vibe coded" bar — money and customer data changes must be traceable.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String

  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String
  /// Before/after diff, secrets already stripped by the caller.
  detail     Json     @default("{}")
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
